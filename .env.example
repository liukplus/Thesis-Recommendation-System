# ============================================
# Thesis Recommendation System — Environment
# Copy to .env and fill in values
# ============================================

# ---- App ----
APP_ENV=dev
APP_NAME=thesis-recsys
LOG_LEVEL=info

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Database ----
DATABASE_URL=sqlite:///./data/thesis.db
# Auto-load bundled demo papers into an empty DB on startup in dev (no-op once populated)
SEED_DEMO_DATA=true

# ---- LLM ----
# OpenAI-compatible endpoint. Works with DeepSeek / Zhipu / Tongyi / OpenAI / vLLM / Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS_PER_QUERY=10000
LLM_TIMEOUT=30

# ---- Embedding ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ---- Reranker ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# ---- Vector DB ----
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/faiss.index
# Qdrant (uncomment for production):
# VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_COLLECTION=papers

# ---- Redis (optional, for task queue) ----
# REDIS_URL=redis://localhost:6379/0

# ---- External APIs ----
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=your@email.com

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- CAT (Meituan APM, requires Docker) ----
# CAT_APPKEY=thesis-recsys
# CAT_ENABLED=true
# CAT_SERVER_HOST=cat-server
# CAT_SERVER_PORT=2280

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
